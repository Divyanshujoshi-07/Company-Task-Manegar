PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/company-task-manager

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# First admin account created automatically by the seed script
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# Hours an employee must work before they can mark attendance (default 8).
# For local testing you can lower this drastically, e.g. 0.02 (~72 seconds),
# to see the "Mark Attendance" button unlock and the presence check fire quickly.
ATTENDANCE_REQUIRED_HOURS=8
